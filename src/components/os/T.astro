---
// Testo bilingue. Renderizza entrambe le lingue; lo switch avviene via CSS
// in base a <html lang>. I token {{...}} diventano chip ".ph" (da compilare).
interface Props {
  it: string;
  en: string;
  class?: string;
}
const { it, en, class: cls = '' } = Astro.props;
const isPh = (s: string) => /^\s*\{\{.*\}\}\s*$/.test(s);
---
<span class:list={['i18n', cls]}
  ><span class="lg lg-it">{isPh(it) ? <span class="ph">{it}</span> : it}</span
  ><span class="lg lg-en">{isPh(en) ? <span class="ph">{en}</span> : en}</span
></span>
