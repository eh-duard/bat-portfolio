---
import BaseLayout from '../layouts/BaseLayout.astro';
import Desktop from '../components/os/Desktop.astro';
import Window from '../components/os/Window.astro';
import Terminal from '../components/os/apps/Terminal.astro';
import Notes from '../components/os/apps/Notes.astro';
import Game from '../components/os/apps/Game.astro';
import Settings from '../components/os/apps/Settings.astro';
import BioApp from '../components/os/apps/BioApp.astro';
import ExperienceApp from '../components/os/apps/ExperienceApp.astro';
import ProjectsApp from '../components/os/apps/ProjectsApp.astro';
import SkillsApp from '../components/os/apps/SkillsApp.astro';
import ContactApp from '../components/os/apps/ContactApp.astro';
---

<BaseLayout>
  <Desktop>
    <Window id="terminal"><Terminal /></Window>
    <Window id="projects"><ProjectsApp /></Window>
    <Window id="about"><BioApp /></Window>
    <Window id="skills"><SkillsApp /></Window>
    <Window id="experience"><ExperienceApp /></Window>
    <Window id="notes"><Notes /></Window>
    <Window id="game"><Game /></Window>
    <Window id="contact"><ContactApp /></Window>
    <Window id="settings"><Settings /></Window>
  </Desktop>
</BaseLayout>
