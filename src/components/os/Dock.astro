---
import { Icon } from 'astro-icon/components';
import { apps } from '../../data/apps';
---

<nav class="dock" aria-label="Dock">
  <ul class="dock__list">
    {apps.map((app) => (
      <li class:list={['dock__li', { 'is-pinned': app.pinned }]} data-dock-li={app.id}>
        <button class="dock__item" data-dock-item={app.id} aria-label={app.label.it}
          style={`--tint:${app.color}`}>
          <span class="run" aria-hidden="true"></span>
          <span class="tile"><Icon name={app.icon} /></span>
          <span class="tip" data-app-label={app.id}>{app.label.it}</span>
        </button>
      </li>
    ))}
  </ul>

  <div class="dock__sep"></div>

  <button class="dock__item dock__grid" data-toggle-startmenu aria-label="Tutte le app">
    <span class="tile tile--grid"><Icon name="lucide:layout-grid" /></span>
    <span class="tip">Tutte le app</span>
  </button>
</nav>

<style>
  .dock {
    position: fixed; top: calc(var(--topbar-h) + 8px); bottom: 8px; left: 8px; z-index: 5500;
    display: flex; flex-direction: column; align-items: center; gap: 0.55rem;
    width: var(--dock-w); padding: 0.55rem 0;
    background: rgba(14,15,20,0.62); backdrop-filter: blur(18px) saturate(1.2);
    border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow);
  }
  .dock__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; overflow: visible; }
  .dock__li { display: none; }
  .dock__li.is-pinned, .dock__li.running { display: block; }

  .dock__item { position: relative; display: grid; place-items: center; }
  .tile {
    width: 46px; height: 46px; display: grid; place-items: center; border-radius: 13px;
    background: linear-gradient(155deg, color-mix(in srgb, var(--tint, #888) 82%, #000), color-mix(in srgb, var(--tint, #888) 52%, #000));
    color: #fff; font-size: 23px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.22), 0 6px 14px -6px rgba(0,0,0,0.7);
    transition: transform 0.16s cubic-bezier(0.2,0.9,0.25,1), box-shadow 0.16s;
  }
  .tile--grid { background: linear-gradient(155deg, #2c313b, #1a1e26); color: var(--text-dim); }
  .dock__item:hover .tile { transform: translateY(-3px) scale(1.06); box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 12px 22px -8px rgba(0,0,0,0.8); }
  .dock__item:active .tile { transform: scale(0.96); }

  .run {
    position: absolute; left: -0.5rem; top: 50%; transform: translateY(-50%) scaleY(0.4);
    width: 3px; height: 22px; border-radius: 3px; background: var(--accent); opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
  }
  .dock__item.running .run { opacity: 0.55; }
  .dock__item.active .run { opacity: 1; transform: translateY(-50%) scaleY(1); }

  .tip {
    position: absolute; left: calc(100% + 0.7rem); top: 50%; transform: translateY(-50%) translateX(-4px);
    padding: 0.25rem 0.55rem; white-space: nowrap; font-size: 0.72rem; color: var(--text);
    background: var(--bg-elev); border: 1px solid var(--line); border-radius: 7px;
    opacity: 0; pointer-events: none; transition: opacity 0.16s, transform 0.16s; z-index: 10;
  }
  .dock__item:hover .tip { opacity: 1; transform: translateY(-50%) translateX(0); }

  .dock__sep { width: 26px; height: 1px; background: var(--line); margin: 0.1rem 0; }

  @media (max-width: 640px) {
    .dock {
      top: auto; bottom: 0; left: 0; right: 0; flex-direction: row; justify-content: center;
      width: auto; height: 66px; border-radius: 16px 16px 0 0; gap: 0.6rem;
      padding: 0.4rem calc(0.6rem + env(safe-area-inset-right)) calc(0.4rem + env(safe-area-inset-bottom));
    }
    .dock__list { flex-direction: row; }
    .dock__sep { width: 1px; height: 26px; }
    .run { left: 50%; top: auto; bottom: -0.35rem; transform: translateX(-50%) scaleX(0.4); width: 20px; height: 3px; }
    .dock__item.active .run { transform: translateX(-50%) scaleX(1); }
    .tip { display: none; }
    body.has-sheet .dock { z-index: 5000; }
  }
</style>
