---
import '../../styles/os.css';
import { Icon } from 'astro-icon/components';
import TopBar from './TopBar.astro';
import Dock from './Dock.astro';
import StartMenu from './StartMenu.astro';
import { apps } from '../../data/apps';

const deskApps = apps.filter((a) => a.desktop);
---

<div id="desktop" data-wall="0">
  <div class="wall wall--grad" aria-hidden="true"></div>
  <div class="wall wall--photo" aria-hidden="true"></div>
  <div class="wall-scrim" aria-hidden="true"></div>
  <div class="wall-glow" aria-hidden="true"></div>
  <div class="wall-dots" aria-hidden="true"></div>

  <TopBar />
  <Dock />

  <div id="desktop-area">
    {deskApps.length > 0 && (
      <div class="desk-icons">
        {deskApps.map((app) => (
          <button class="desk-ico" data-desktop-icon={app.id} style={`--tint:${app.color}`} tabindex="0">
            <span class="tile"><Icon name={app.icon} /></span>
            <span data-app-label={app.id}>{app.label.it}</span>
          </button>
        ))}
      </div>
    )}
    <slot />
  </div>

  <StartMenu />

  <div id="boot" role="dialog" aria-label="Avvio">
    <div class="boot__inner">
      <div class="boot__logo"><Icon name="lucide:hexagon" /></div>
      <div class="boot__name">NOX//OS</div>
      <div class="boot__log">
        <span><b>&gt;</b> kernel noxsh caricato</span>
        <span><b>&gt;</b> mount /home/visitor … ok</span>
        <span><b>&gt;</b> avvio compositore grafico</span>
        <span><b>&gt;</b> montaggio progetti e stack</span>
        <span><b>&gt;</b> pronto. clicca per entrare.</span>
      </div>
      <div class="boot__bar"></div>
    </div>
  </div>
</div>

<script>
  import '../../scripts/os-manager.ts';
</script>
