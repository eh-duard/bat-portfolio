---
import { Icon } from 'astro-icon/components';
import { apps } from '../../data/apps';
---

<div id="startmenu" class="sm" hidden>
  <div class="sm__backdrop" data-close-startmenu></div>
  <div class="sm__panel" role="dialog" aria-label="Tutte le applicazioni">
    <div class="sm__searchwrap">
      <Icon name="lucide:search" class="sm__searchico" />
      <input id="sm-search" class="sm__search" type="text" placeholder="Cerca applicazioni…" autocomplete="off" spellcheck="false" />
    </div>
    <div class="sm__grid" id="sm-grid">
      {apps.map((app) => (
        <button class="sm__app" data-launch={app.id} data-name={`${app.label.it} ${app.label.en}`.toLowerCase()}>
          <span class="sm__tile" style={`--tint:${app.color}`}><Icon name={app.icon} /></span>
          <span class="sm__label" data-app-label={app.id}>{app.label.it}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .sm { position: fixed; inset: 0; z-index: 7000; display: grid; place-items: start center; }
  .sm[hidden] { display: none; }
  .sm__backdrop { position: absolute; inset: 0; background: rgba(6,7,10,0.55); backdrop-filter: blur(10px); opacity: 0; transition: opacity 0.25s; }
  .sm.is-open .sm__backdrop { opacity: 1; }

  .sm__panel {
    position: relative; width: min(760px, 92vw); margin-top: 9vh; padding: 1.4rem;
    transform: translateY(-12px) scale(0.98); opacity: 0; transition: transform 0.28s cubic-bezier(0.2,0.9,0.25,1), opacity 0.2s;
  }
  .sm.is-open .sm__panel { transform: none; opacity: 1; }

  .sm__searchwrap { position: relative; margin: 0 auto 1.8rem; max-width: 440px; }
  .sm__searchico { position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); font-size: 17px; color: var(--text-mute); }
  .sm__search {
    width: 100%; padding: 0.7rem 1rem 0.7rem 2.5rem; font-size: 0.95rem;
    background: var(--bg-input); border: 1px solid var(--line); border-radius: 12px; color: var(--text); outline: none;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .sm__search:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }

  .sm__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 0.6rem; }
  .sm__app { display: flex; flex-direction: column; align-items: center; gap: 0.55rem; padding: 0.9rem 0.4rem; border-radius: 14px; transition: background 0.15s; }
  .sm__app:hover { background: rgba(255,255,255,0.06); }
  .sm__app[hidden] { display: none; }
  .sm__tile {
    width: 56px; height: 56px; display: grid; place-items: center; border-radius: 16px; color: #fff; font-size: 27px;
    background: linear-gradient(155deg, color-mix(in srgb, var(--tint) 82%, #000), color-mix(in srgb, var(--tint) 50%, #000));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.22), 0 8px 16px -8px rgba(0,0,0,0.7);
    transition: transform 0.16s;
  }
  .sm__app:hover .sm__tile { transform: translateY(-3px); }
  .sm__label { font-size: 0.76rem; color: var(--text-dim); text-align: center; }
  .sm__app:hover .sm__label { color: var(--text); }
</style>

<script>
  const search = document.getElementById('sm-search') as HTMLInputElement | null;
  const apps = Array.from(document.querySelectorAll<HTMLElement>('#sm-grid .sm__app'));
  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    apps.forEach((a) => { a.hidden = q ? !(a.dataset.name || '').includes(q) : false; });
  });
</script>
