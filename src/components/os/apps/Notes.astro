---
import { Icon } from 'astro-icon/components';
---

<div class="notes" data-flush>
  <aside class="notes__side">
    <button class="notes__new" id="note-new"><Icon name="lucide:plus" /> Nuova nota</button>
    <ul class="notes__list" id="note-list"></ul>
    <p class="notes__hint">Salvate nel tuo browser<br />(localStorage)</p>
  </aside>

  <section class="notes__main">
    <input class="notes__title" id="note-title" type="text" placeholder="Titolo della nota…" />
    <textarea class="notes__body" id="note-body" placeholder="Scrivi qui. Tutto resta sul tuo dispositivo." spellcheck="false"></textarea>
    <div class="notes__bar">
      <span class="notes__status" id="note-status"></span>
      <span class="notes__spacer"></span>
      <button class="notes__btn" id="note-export"><Icon name="lucide:download" /> Esporta .txt</button>
      <button class="notes__btn notes__btn--danger" id="note-del"><Icon name="lucide:trash-2" /></button>
    </div>
  </section>
</div>

<style>
  .notes { display: grid; grid-template-columns: 190px 1fr; height: 100%; background: var(--bg-panel); }
  .notes__side { border-right: 1px solid var(--line); display: flex; flex-direction: column; padding: 0.7rem; gap: 0.5rem; background: var(--bg); }
  .notes__new { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.5rem; border: 1px solid var(--line); border-radius: 8px; color: var(--text); font-size: 0.8rem; transition: background 0.15s, border-color 0.15s; }
  .notes__new:hover { background: var(--accent-soft); border-color: var(--accent); }
  .notes__list { list-style: none; margin: 0; padding: 0; flex: 1; overflow: auto; display: flex; flex-direction: column; gap: 0.2rem; }
  .notes__list li { padding: 0.5rem 0.6rem; border-radius: 7px; cursor: pointer; font-size: 0.8rem; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: background 0.12s, color 0.12s; }
  .notes__list li:hover { background: rgba(255,255,255,0.05); color: var(--text); }
  .notes__list li.active { background: var(--accent-soft); color: var(--text); box-shadow: inset 2px 0 0 var(--accent); }
  .notes__list li small { display: block; font-size: 0.62rem; color: var(--text-mute); }
  .notes__hint { font-size: 0.62rem; color: var(--text-mute); text-align: center; margin: 0; line-height: 1.4; }

  .notes__main { display: flex; flex-direction: column; min-width: 0; }
  .notes__title { padding: 0.8rem 1rem 0.4rem; font-size: 1.05rem; font-weight: 600; background: transparent; border: none; border-bottom: 1px solid var(--line-soft); outline: none; }
  .notes__body { flex: 1; resize: none; padding: 0.9rem 1rem; background: transparent; border: none; outline: none; font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.6; color: var(--text-dim); }
  .notes__bar { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.7rem; border-top: 1px solid var(--line); background: var(--bg); }
  .notes__status { font-size: 0.68rem; color: var(--text-mute); }
  .notes__spacer { flex: 1; }
  .notes__btn { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.6rem; border: 1px solid var(--line); border-radius: 7px; font-size: 0.72rem; color: var(--text-dim); transition: background 0.15s, color 0.15s, border-color 0.15s; }
  .notes__btn:hover { background: rgba(255,255,255,0.05); color: var(--text); }
  .notes__btn--danger:hover { background: var(--danger); border-color: var(--danger); color: #fff; }

  @media (max-width: 560px) {
    .notes { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .notes__side { flex-direction: row; align-items: center; border-right: none; border-bottom: 1px solid var(--line); overflow-x: auto; }
    .notes__list { flex-direction: row; }
    .notes__hint { display: none; }
  }
</style>

<script is:inline>
  (function () {
    const KEY = 'nox-notes';
    const listEl = document.getElementById('note-list');
    const titleEl = document.getElementById('note-title');
    const bodyEl = document.getElementById('note-body');
    const statusEl = document.getElementById('note-status');
    if (!listEl || !titleEl || !bodyEl) return;

    const load = () => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
    const save = (n) => { try { localStorage.setItem(KEY, JSON.stringify(n)); } catch {} };
    let notes = load();
    let currentId = null;
    let t;

    function fmt(ts) { return new Date(ts).toLocaleDateString('it-IT', { day: '2-digit', month: 'short' }) + ' ' + new Date(ts).toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' }); }

    function renderList() {
      listEl.innerHTML = '';
      if (!notes.length) { listEl.innerHTML = '<li style="color:var(--text-mute);cursor:default">Nessuna nota</li>'; return; }
      notes.slice().sort((a, b) => b.updated - a.updated).forEach((n) => {
        const li = document.createElement('li');
        li.className = n.id === currentId ? 'active' : '';
        li.innerHTML = (n.title ? n.title.replace(/</g, '&lt;') : 'Senza titolo') + '<small>' + fmt(n.updated) + '</small>';
        li.onclick = () => select(n.id);
        listEl.appendChild(li);
      });
    }
    function select(id) {
      const n = notes.find((x) => x.id === id);
      if (!n) return;
      currentId = id; titleEl.value = n.title; bodyEl.value = n.body;
      statusEl.textContent = 'aggiornata ' + fmt(n.updated);
      renderList();
    }
    function create() {
      const n = { id: Date.now().toString(36), title: '', body: '', updated: Date.now() };
      notes.push(n); currentId = n.id; save(notes);
      titleEl.value = ''; bodyEl.value = ''; statusEl.textContent = 'nuova nota';
      renderList(); titleEl.focus();
    }
    function persist() {
      if (currentId == null) { create(); }
      const n = notes.find((x) => x.id === currentId);
      if (!n) return;
      n.title = titleEl.value; n.body = bodyEl.value; n.updated = Date.now();
      save(notes); statusEl.textContent = 'salvata ' + fmt(n.updated); renderList();
    }
    const debounced = () => { statusEl.textContent = 'scrittura…'; clearTimeout(t); t = setTimeout(persist, 500); };

    document.getElementById('note-new').onclick = create;
    titleEl.addEventListener('input', debounced);
    bodyEl.addEventListener('input', debounced);
    document.getElementById('note-del').onclick = () => {
      if (currentId == null) return;
      notes = notes.filter((x) => x.id !== currentId); save(notes);
      currentId = null; titleEl.value = ''; bodyEl.value = ''; statusEl.textContent = 'eliminata'; renderList();
    };
    document.getElementById('note-export').onclick = () => {
      const name = (titleEl.value.trim() || 'nota') + '.txt';
      const blob = new Blob([bodyEl.value], { type: 'text/plain' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = name; a.click();
      URL.revokeObjectURL(a.href);
    };

    renderList();
    if (notes.length) select(notes.slice().sort((a, b) => b.updated - a.updated)[0].id);
  })();
</script>
