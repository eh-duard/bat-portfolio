---
import content from '../../../data/content.json';
import T from '../T.astro';
import V from '../V.astro';

const { identity, stats } = content;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="bio">
  <div class="bio__portrait">
    <div class="frame">
      <img src={`${base}/images/propic.png`} alt="" loading="lazy" width="200" height="240" />
      <span class="scan"></span>
      <span class="stamp stamp--bat">CLASSIFIED</span>
      <span class="stamp stamp--dev">~/profile</span>
    </div>
    <p class="handle font-mono"><V value={identity.handle} /></p>
  </div>

  <div class="bio__body">
    <p class="eyebrow font-mono">
      <span class="dev-only">// identita'</span>
      <span class="bat-only">DOSSIER · 492</span>
    </p>
    <h2 class="name"><V value={identity.name} /></h2>
    <p class="role"><T it={identity.role.it} en={identity.role.en} /></p>

    <p class="bio__text"><T it={identity.bio.it} en={identity.bio.en} /></p>

    <dl class="meta font-mono">
      <div>
        <dt><span class="dev-only">location</span><span class="bat-only">BASE</span></dt>
        <dd><T it={identity.location.it} en={identity.location.en} /></dd>
      </div>
      <div>
        <dt><span class="dev-only">status</span><span class="bat-only">STATO</span></dt>
        <dd class="live"><span class="dot"></span><T it={identity.availability.it} en={identity.availability.en} /></dd>
      </div>
    </dl>

    <ul class="stats">
      {stats.map((s) => (
        <li>
          <span class="stat__v"><V value={s.value} /></span>
          <span class="stat__l font-mono"><T it={s.label.it} en={s.label.en} /></span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .bio { display: grid; grid-template-columns: auto 1fr; gap: 1.6rem; padding: 0.4rem 0.2rem; }
  .bio__portrait { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }

  .frame {
    position: relative; width: 150px; aspect-ratio: 5 / 6;
    border: 1px solid var(--line);
    outline: 3px solid var(--bg); outline-offset: -3px;
    overflow: hidden; background: var(--bg-3);
    box-shadow: var(--glow);
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.4) contrast(1.05); }
  html[data-mode='batman'] .frame img { filter: grayscale(1) contrast(1.2) brightness(0.92); }
  html[data-mode='batman'] .frame { border-color: var(--accent); }

  .scan {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(transparent 0%, var(--accent-soft) 50%, transparent 100%);
    background-size: 100% 6px; opacity: 0; mix-blend-mode: screen;
  }
  html[data-mode='batman'] .scan { opacity: 1; animation: scan 3.5s linear infinite; }
  @keyframes scan { from { transform: translateY(-100%); } to { transform: translateY(100%); } }

  .stamp {
    position: absolute; bottom: 0; left: 0; right: 0;
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.22em;
    text-align: center; padding: 3px; text-transform: uppercase;
    border-top: 1px solid var(--accent); color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .stamp--dev { color: var(--text-mute); border-color: var(--line); background: var(--bg-2); text-transform: none; letter-spacing: 0.1em; }
  html[data-mode='batman'] .stamp--dev { display: none; }
  html:not([data-mode='batman']) .stamp--bat { display: none; }

  .handle { font-size: 0.72rem; color: var(--text-mute); letter-spacing: 0.05em; }

  .eyebrow { font-size: 0.68rem; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase; margin: 0 0 0.5rem; }
  .name {
    font-size: 1.7rem; line-height: 1.05; margin: 0 0 0.15rem; font-weight: 600;
    letter-spacing: -0.01em;
  }
  html[data-mode='batman'] .name { font-family: var(--font-display); letter-spacing: 0.04em; text-shadow: var(--glow); }
  .role { color: var(--text-dim); font-size: 0.9rem; margin: 0 0 1rem; letter-spacing: 0.04em; }
  .bio__text { color: var(--text-dim); font-size: 0.92rem; line-height: 1.6; margin: 0 0 1.2rem; max-width: 46ch; }

  .meta { display: flex; gap: 1.8rem; margin: 0 0 1.3rem; font-size: 0.72rem; }
  .meta dt { color: var(--text-mute); letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.25rem; }
  .meta dd { margin: 0; color: var(--text); }
  .live { display: inline-flex; align-items: center; gap: 0.4rem; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.35; } }

  .stats { list-style: none; display: flex; gap: 0.6rem; padding: 0; margin: 0; }
  .stats li {
    flex: 1; border: 1px solid var(--line); background: var(--bg-2);
    padding: 0.7rem 0.6rem; border-radius: var(--radius-sm); text-align: left;
  }
  .stat__v { display: block; font-size: 1.35rem; font-weight: 600; line-height: 1; }
  html[data-mode='batman'] .stat__v { color: var(--accent); font-family: var(--font-display); }
  .stat__l { display: block; font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); margin-top: 0.35rem; }

  .dev-only { display: inline; }
  .bat-only { display: none; }
  html[data-mode='batman'] .dev-only { display: none; }
  html[data-mode='batman'] .bat-only { display: inline; }

  @media (max-width: 560px) {
    .bio { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .bio__text { text-align: left; }
    .meta { justify-content: center; }
  }
</style>
