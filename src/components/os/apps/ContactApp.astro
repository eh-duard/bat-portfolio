---
import content from '../../../data/content.json';
import { icon } from '../../../data/icons';
import T from '../T.astro';
import V from '../V.astro';

const { contact } = content;
const isPh = (s: string) => /^\s*\{\{.*\}\}\s*$/.test(String(s));
const mail = isPh(contact.email) ? undefined : `mailto:${contact.email}`;
const gh = isPh(contact.github) ? undefined : contact.github;
const li = isPh(contact.linkedin) ? undefined : contact.linkedin;
---

<div class="contact">
  <div class="beacon" role="img" aria-label="signal">
    <span class="ring"></span>
    <span class="bat" set:html={icon('bat')}></span>
    <span class="beam"></span>
  </div>

  <p class="eyebrow font-mono">
    <span class="dev-only">// mettiamoci in contatto</span>
    <span class="bat-only">ACCENDI IL SEGNALE</span>
  </p>
  <h2 class="cta"><T it={contact.cta.it} en={contact.cta.en} /></h2>

  <a class="primary font-mono" href={mail} aria-disabled={!mail}>
    <span set:html={icon('mail')}></span>
    <span class="dev-only">Scrivimi</span><span class="bat-only">Trasmetti</span>
    <em class="addr"><V value={contact.email} /></em>
  </a>

  <div class="links font-mono">
    <a href={gh} aria-disabled={!gh}><span set:html={icon('branch')}></span> GitHub</a>
    <a href={li} aria-disabled={!li}><span set:html={icon('network')}></span> LinkedIn</a>
  </div>
</div>

<style>
  .contact { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0.6rem 0.4rem 0.4rem; }

  .beacon { position: relative; width: 110px; height: 110px; display: grid; place-items: center; margin-bottom: 1.2rem; }
  .ring { position: absolute; inset: 0; border-radius: 50%; border: 1px solid var(--line); background: radial-gradient(circle at 50% 45%, var(--bg-3), var(--bg)); box-shadow: inset 0 0 24px rgba(0,0,0,0.6), var(--glow); }
  .bat { width: 60px; color: var(--accent); filter: drop-shadow(0 0 8px var(--accent-soft)); z-index: 1; }
  html:not([data-mode='batman']) .bat { color: var(--text-dim); filter: none; }
  .beam {
    position: absolute; bottom: 52%; left: 50%; width: 120px; height: 160px;
    transform: translateX(-50%);
    background: linear-gradient(to top, var(--accent-soft), transparent);
    clip-path: polygon(38% 100%, 62% 100%, 100% 0, 0 0);
    opacity: 0; transition: opacity 0.6s;
  }
  html[data-mode='batman'] .beacon:hover .beam { opacity: 0.8; }

  .eyebrow { font-size: 0.68rem; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase; margin: 0 0 0.5rem; }
  .cta { margin: 0 0 1.4rem; font-size: 1.5rem; font-weight: 600; max-width: 22ch; }
  html[data-mode='batman'] .cta { font-family: var(--font-display); letter-spacing: 0.03em; }

  .primary {
    display: inline-flex; align-items: center; gap: 0.6rem;
    border: 1px solid var(--accent); color: var(--text);
    padding: 0.7rem 1.2rem; border-radius: var(--radius-sm);
    font-size: 0.82rem; letter-spacing: 0.05em; transition: background 0.25s, color 0.25s;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .primary :global(svg) { width: 18px; }
  .primary:hover { background: var(--accent); color: #05070b; }
  .primary[aria-disabled='true'] { pointer-events: none; opacity: 0.6; border-style: dashed; }
  .addr { font-style: normal; color: var(--text-mute); font-size: 0.72rem; }
  .primary:hover .addr { color: inherit; }

  .links { display: flex; gap: 1.6rem; margin-top: 1.3rem; font-size: 0.76rem; }
  .links a { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--text-dim); border-bottom: 1px solid transparent; padding-bottom: 2px; transition: color 0.2s, border-color 0.2s; }
  .links a:hover { color: var(--accent); border-color: var(--accent); }
  .links a[aria-disabled='true'] { color: var(--text-mute); pointer-events: none; }
  .links :global(svg) { width: 15px; }

  .dev-only { display: inline; } .bat-only { display: none; }
  html[data-mode='batman'] .dev-only { display: none; }
  html[data-mode='batman'] .bat-only { display: inline; }
</style>
