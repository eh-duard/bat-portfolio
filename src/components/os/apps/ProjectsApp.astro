---
import content from '../../../data/content.json';
import T from '../T.astro';
import V from '../V.astro';

const { projects } = content;
const isPh = (s: string) => /^\s*\{\{.*\}\}\s*$/.test(String(s));
---

<div class="proj">
  <p class="eyebrow font-mono">
    <span class="dev-only">// lavori selezionati</span>
    <span class="bat-only">ARCHIVIO · TOP SECRET</span>
  </p>

  <div class="grid">
    {projects.map((p, i) => (
      <article class="pcard">
        <header class="pcard__head font-mono">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="file">{isPh(p.codename) ? '{{CODENAME}}' : p.codename}</span>
        </header>
        <div class="pcard__body">
          <h3 class="title"><V value={p.title} /></h3>
          <p class="desc"><T it={p.desc.it} en={p.desc.en} /></p>
        </div>
        <footer class="pcard__foot">
          <ul class="tech font-mono">
            {p.tech.map((t) => <li><V value={t} /></li>)}
          </ul>
          <a class="open font-mono" href={isPh(p.url) ? undefined : p.url} aria-disabled={isPh(p.url)}>
            <span class="dev-only">open →</span><span class="bat-only">apri ›</span>
          </a>
        </footer>
      </article>
    ))}
  </div>
</div>

<style>
  .proj { padding: 0.2rem; }
  .eyebrow { font-size: 0.68rem; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase; margin: 0 0 1.2rem; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.9rem; }

  .pcard {
    display: flex; flex-direction: column;
    border: 1px solid var(--line); background: var(--bg-2);
    border-radius: var(--radius-sm); overflow: hidden;
    transition: border-color 0.25s, transform 0.25s;
  }
  .pcard:hover { border-color: var(--accent); transform: translateY(-2px); }

  .pcard__head {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--line-soft);
    background: linear-gradient(var(--titlebar-a), var(--titlebar-b));
    font-size: 0.65rem; color: var(--text-mute); letter-spacing: 0.05em;
  }
  .dots { display: inline-flex; gap: 4px; }
  .dots i { width: 8px; height: 8px; border-radius: 50%; border: 1px solid var(--line); }
  .dots i:nth-child(1) { border-color: var(--danger); }
  .dots i:nth-child(3) { border-color: var(--accent); }
  .file { color: var(--text-dim); }

  .pcard__body { padding: 0.9rem 0.8rem 0.6rem; flex: 1; }
  .title { margin: 0 0 0.4rem; font-size: 1rem; font-weight: 600; }
  html[data-mode='batman'] .title { font-family: var(--font-display); color: var(--accent); letter-spacing: 0.02em; }
  .desc { margin: 0; color: var(--text-dim); font-size: 0.82rem; line-height: 1.5; }

  .pcard__foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.55rem 0.8rem; border-top: 1px solid var(--line-soft); }
  .tech { display: flex; flex-wrap: wrap; gap: 0.3rem; list-style: none; margin: 0; padding: 0; }
  .tech li { font-size: 0.58rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-mute); padding: 0.12rem 0.4rem; border: 1px solid var(--line); border-radius: 2px; }
  .open { font-size: 0.68rem; color: var(--accent); white-space: nowrap; }
  .open[aria-disabled='true'] { color: var(--text-mute); pointer-events: none; }

  .dev-only { display: inline; } .bat-only { display: none; }
  html[data-mode='batman'] .dev-only { display: none; }
  html[data-mode='batman'] .bat-only { display: inline; }
</style>
