---
import { apps, appLabel } from '../../data/apps';
import { icon } from '../../data/icons';
const dockApps = apps.filter((a) => a.dock);
---

<nav class="dock" aria-label="Dock">
  <ul class="dock__list">
    {dockApps.map((app) => (
      <li>
        <button class="dock__item" data-dock-item={app.id} aria-label={appLabel(app, 'batman', 'it')}>
          <span class="dock__tip" data-app-label={app.id}>{appLabel(app, 'batman', 'it')}</span>
          <span class="glyph" set:html={icon(app.icon)}></span>
          <span class="run-dot" aria-hidden="true"></span>
        </button>
      </li>
    ))}
  </ul>
</nav>

<style>
  .dock {
    position: fixed; bottom: 0.7rem; left: 50%; transform: translateX(-50%);
    z-index: 5500;
  }
  .dock__list {
    display: flex; align-items: flex-end; gap: 0.4rem; list-style: none; margin: 0;
    padding: 0.4rem 0.55rem;
    background: color-mix(in srgb, var(--bg-2) 80%, transparent);
    backdrop-filter: blur(16px) saturate(1.15);
    border: 1px solid var(--line); border-radius: 16px;
    box-shadow: var(--shadow);
  }
  html[data-mode='batman'] .dock__list { border-color: color-mix(in srgb, var(--accent) 22%, var(--line)); }

  .dock__item {
    position: relative; width: 46px; height: 46px; display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 12px; background: linear-gradient(160deg, var(--bg-3), var(--bg-2));
    color: var(--accent); transition: transform 0.18s cubic-bezier(0.2,0.8,0.2,1), border-color 0.18s;
  }
  html:not([data-mode='batman']) .dock__item { color: var(--text); }
  .dock__item:hover { transform: translateY(-8px) scale(1.06); border-color: var(--accent); }
  .dock__item.active { border-color: var(--accent); }
  .glyph, .glyph :global(svg) { width: 24px; }

  .run-dot {
    position: absolute; bottom: -0.5rem; left: 50%; transform: translateX(-50%);
    width: 4px; height: 4px; border-radius: 50%; background: var(--accent);
    opacity: 0; transition: opacity 0.2s;
  }
  .dock__item.running .run-dot { opacity: 1; }

  .dock__tip {
    position: absolute; bottom: calc(100% + 0.5rem); left: 50%; transform: translateX(-50%) translateY(4px);
    padding: 0.2rem 0.5rem; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.04em;
    white-space: nowrap; color: var(--text); background: var(--bg-raised); border: 1px solid var(--line);
    border-radius: var(--radius-sm); opacity: 0; pointer-events: none; transition: opacity 0.18s, transform 0.18s;
  }
  .dock__item:hover .dock__tip { opacity: 1; transform: translateX(-50%) translateY(0); }

  @media (max-width: 640px) {
    .dock { bottom: 0; left: 0; right: 0; transform: none; }
    .dock__list { border-radius: 14px 14px 0 0; justify-content: center; padding: 0.5rem 0.6rem calc(0.5rem + env(safe-area-inset-bottom)); border-bottom: none; }
    .dock__item { width: 42px; height: 42px; }
    .dock__tip { display: none; }
    body.has-sheet .dock { z-index: 5000; }
  }
</style>
