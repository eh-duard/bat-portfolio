---
import content from '../../../data/content.json';
import T from '../T.astro';
import V from '../V.astro';

const { skills } = content;
---

<div class="skills">
  <div class="skills__head">
    <p class="eyebrow font-mono">
      <span class="dev-only">// stack tecnologico</span>
      <span class="bat-only">ARSENALE TATTICO</span>
    </p>
    <span class="ready font-mono">ONLINE</span>
  </div>

  <ul class="list">
    {skills.map((s, i) => (
      <li class="skill" style={`--lvl:${s.level}%`}>
        <div class="skill__row">
          <span class="tag font-mono">{s.tag}</span>
          <span class="names">
            <span class="cat"><T it={s.codename.it} en={s.codename.en} /></span>
            <span class="raw font-mono">(<V value={s.name} />)</span>
          </span>
          <span class="pct font-mono">{s.level}%</span>
        </div>
        <div class="bar"><span class="fill" style={`animation-delay:${i * 80}ms`}></span></div>
      </li>
    ))}
  </ul>
</div>

<style>
  .skills { padding: 0.2rem; }
  .skills__head { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); padding-bottom: 0.7rem; margin-bottom: 1.1rem; }
  .eyebrow { font-size: 0.68rem; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase; margin: 0; }
  .ready { font-size: 0.6rem; letter-spacing: 0.2em; color: var(--accent); border: 1px solid var(--accent); padding: 0.15rem 0.5rem; animation: blink 2.4s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0.35; } }

  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .skill__row { display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 0.4rem; }
  .tag { font-size: 0.6rem; color: var(--text-mute); letter-spacing: 0.08em; min-width: 2.8rem; }
  .names { flex: 1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem; }
  .cat { font-size: 0.95rem; font-weight: 600; }
  html[data-mode='batman'] .cat { font-family: var(--font-display); letter-spacing: 0.03em; }
  .raw { font-size: 0.66rem; color: var(--text-mute); }
  .pct { font-size: 0.72rem; color: var(--accent); }

  .bar { height: 3px; background: var(--bg-3); border: 1px solid var(--line-soft); overflow: hidden; }
  .fill {
    display: block; height: 100%; width: var(--lvl);
    background: var(--accent); box-shadow: var(--glow);
    transform-origin: left; animation: grow 0.9s cubic-bezier(0.2,0.8,0.2,1) both;
  }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .dev-only { display: inline; } .bat-only { display: none; }
  html[data-mode='batman'] .dev-only { display: none; }
  html[data-mode='batman'] .bat-only { display: inline; }
</style>
