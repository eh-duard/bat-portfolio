---
import '../styles/global.css';
// Font self-hostati (Fontsource) - niente CDN esterno a runtime
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'BAT-DESK — Portfolio',
  description = 'Un portfolio che si comporta come un desktop. Terminale, finestre, note, mini-gioco.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=5" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d0e12" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <script is:inline>
      try {
        var l = localStorage.getItem('nox-lang');
        document.documentElement.setAttribute('lang', l === 'en' ? 'en' : 'it');
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
