---
import BaseLayout from '../layouts/BaseLayout.astro';
import Desktop from '../components/os/Desktop.astro';
import Window from '../components/os/Window.astro';
import Terminal from '../components/os/apps/Terminal.astro';
import Game from '../components/os/apps/Game.astro';
import Notes from '../components/os/apps/Notes.astro';
import Settings from '../components/os/apps/Settings.astro';
---

<BaseLayout>
  <Desktop>
    <Window id="terminal"><Terminal /></Window>
    <Window id="game"><Game /></Window>
    <Window id="notes"><Notes /></Window>
    <Window id="settings"><Settings /></Window>
  </Desktop>
</BaseLayout>
