---
import { Icon } from 'astro-icon/components';
import { appById } from '../../data/apps';

interface Props { id: string; }
const { id } = Astro.props;
const app = appById(id)!;
---

<article id={`win-${id}`} class="win" data-app={id} role="dialog" aria-label={app.label.it} aria-hidden="true" hidden>
  <header class="win__bar" data-drag>
    <span class="win__ico" style={`color:${app.color}`}><Icon name={app.icon} /></span>
    <span class="win__title" data-app-label={id}>{app.label.it}</span>
    <span class="win__spacer"></span>
    <span class="win__ctrl">
      <button class="wc wc--min" data-action="min" aria-label="Riduci"><Icon name="lucide:minus" /></button>
      <button class="wc wc--max" data-action="max" aria-label="Espandi"><Icon name="lucide:square" /></button>
      <button class="wc wc--close" data-action="close" aria-label="Chiudi"><Icon name="lucide:x" /></button>
    </span>
  </header>
  <div class="win__body">
    <slot />
  </div>

  <span class="rz rz-n"  data-resize="n"></span>
  <span class="rz rz-s"  data-resize="s"></span>
  <span class="rz rz-e"  data-resize="e"></span>
  <span class="rz rz-w"  data-resize="w"></span>
  <span class="rz rz-ne" data-resize="ne"></span>
  <span class="rz rz-nw" data-resize="nw"></span>
  <span class="rz rz-se" data-resize="se"></span>
  <span class="rz rz-sw" data-resize="sw"></span>
</article>

<style>
  .win {
    position: absolute; display: flex; flex-direction: column;
    min-width: 280px; min-height: 180px;
    background: var(--bg-panel);
    border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow); overflow: hidden;
    opacity: 0; transform: scale(0.96) translateY(10px);
    transition: opacity 0.24s ease, transform 0.28s cubic-bezier(0.2,0.9,0.25,1), box-shadow 0.2s;
    will-change: transform, opacity;
  }
  .win.is-open { opacity: 1; transform: none; }
  .win.is-min { opacity: 0; transform: scale(0.88) translateY(60px); }
  .win.is-active { box-shadow: var(--shadow-lg); border-color: color-mix(in srgb, var(--accent) 32%, var(--line)); }
  .win.is-dragging { transition: none; cursor: grabbing; user-select: none; }
  .win--max { left: 0 !important; top: 0 !important; width: 100% !important; height: 100% !important; border-radius: 0; }

  .win__bar {
    display: flex; align-items: center; gap: 0.6rem; height: 40px; flex: none;
    padding: 0 0.5rem 0 0.85rem; cursor: grab;
    background: var(--bg-header); border-bottom: 1px solid var(--line-soft);
    user-select: none;
  }
  .win__bar:active { cursor: grabbing; }
  .win__ico { font-size: 17px; display: inline-flex; }
  .win__title { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.01em; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .win__spacer { flex: 1; }

  .win__ctrl { display: flex; gap: 0.3rem; }
  .wc {
    width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%;
    background: var(--bg-elev); color: var(--text-dim); font-size: 15px;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }
  .wc:hover { background: #33383f; color: var(--text); }
  .wc--close:hover { background: var(--danger); color: #fff; }
  .wc:active { transform: scale(0.9); }

  .win__body { flex: 1; overflow: auto; padding: 1.2rem 1.3rem 1.4rem; position: relative; }
  .win__body.is-flush { padding: 0; }

  /* maniglie di ridimensionamento */
  .rz { position: absolute; z-index: 5; touch-action: none; }
  .rz-n { top: -3px; left: 8px; right: 8px; height: 7px; cursor: ns-resize; }
  .rz-s { bottom: -3px; left: 8px; right: 8px; height: 7px; cursor: ns-resize; }
  .rz-e { right: -3px; top: 8px; bottom: 8px; width: 7px; cursor: ew-resize; }
  .rz-w { left: -3px; top: 8px; bottom: 8px; width: 7px; cursor: ew-resize; }
  .rz-ne { top: -4px; right: -4px; width: 14px; height: 14px; cursor: nesw-resize; }
  .rz-nw { top: -4px; left: -4px; width: 14px; height: 14px; cursor: nwse-resize; }
  .rz-se { bottom: -4px; right: -4px; width: 14px; height: 14px; cursor: nwse-resize; }
  .rz-sw { bottom: -4px; left: -4px; width: 14px; height: 14px; cursor: nesw-resize; }
  .win--max .rz, .win--sheet .rz { display: none; }

  /* Phone: finestre a schermo intero */
  .win--sheet {
    position: fixed !important; inset: var(--topbar-h) 0 0 0 !important;
    width: auto !important; height: auto !important; border-radius: 0; border: none;
    transform: translateY(100%);
  }
  .win--sheet.is-open { transform: none; }
  .win--sheet.is-min { transform: translateY(100%); }
  .win--sheet .wc--min, .win--sheet .wc--max { display: none; }
</style>
