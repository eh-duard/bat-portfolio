---
import { apps, appLabel } from '../../data/apps';
import { icon } from '../../data/icons';
---

<div id="home-grid" class="icons">
  {apps.map((app) => (
    <button class="app-ico" data-launch={app.id} tabindex="0">
      <span class="app-ico__tile"><span class="glyph" set:html={icon(app.icon)}></span></span>
      <span class="app-ico__label" data-app-label={app.id}>{appLabel(app, 'batman', 'it')}</span>
    </button>
  ))}
</div>

<style>
  /* Desktop / tablet: colonna di icone in alto a sinistra */
  .icons {
    position: absolute; top: 1.1rem; left: 1.1rem; z-index: 100;
    display: flex; flex-direction: column; gap: 0.55rem;
  }
  .app-ico {
    display: flex; flex-direction: column; align-items: center; gap: 0.35rem;
    width: 84px; padding: 0.5rem 0.3rem; background: transparent; border: 1px solid transparent;
    border-radius: var(--radius); color: var(--text-dim); transition: background 0.18s, border-color 0.18s, color 0.18s;
  }
  .app-ico:hover { color: var(--text); }
  .app-ico.selected { background: var(--accent-soft); border-color: var(--accent); color: var(--text); }
  .app-ico:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .app-ico__tile {
    width: 48px; height: 48px; display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 12px;
    background: linear-gradient(160deg, var(--bg-3), var(--bg-2));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 6px 14px -8px rgba(0,0,0,0.8);
  }
  html[data-mode='batman'] .app-ico__tile { box-shadow: inset 0 1px 0 rgba(230,193,90,0.06), 0 6px 16px -8px rgba(0,0,0,0.9); }
  .glyph, .glyph :global(svg) { width: 24px; color: var(--accent); }
  html:not([data-mode='batman']) .glyph, html:not([data-mode='batman']) .glyph :global(svg) { color: var(--text); }
  .app-ico__label { font-size: 0.66rem; letter-spacing: 0.02em; text-align: center; line-height: 1.15; }

  /* Phone: home screen a griglia centrata */
  @media (max-width: 640px) {
    .icons {
      position: absolute; inset: 0; top: 3.6rem;
      display: grid; grid-template-columns: repeat(3, 1fr); align-content: start; justify-items: center;
      gap: 1.4rem 0.5rem; padding: 1.4rem 1rem 6rem;
    }
    .app-ico { width: 100%; max-width: 96px; }
    .app-ico__tile { width: 60px; height: 60px; border-radius: 16px; }
    .glyph, .glyph :global(svg) { width: 30px; }
    .app-ico__label { font-size: 0.72rem; color: var(--text); }
    body.has-sheet .icons { opacity: 0; pointer-events: none; }
  }
</style>
